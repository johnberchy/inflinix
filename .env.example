# Inflinix configuration. Copy to .env (gitignored) and fill in.

INFLINIX_ENV=development
MEMORY_DRIVER=accred
ACCRED_MEMORY_DB=.inflinix/inflinix.db
ACCRED_TENANT_ID=inflinix-credit

# --- Robinhood chain ---
# Robinhood = 4663, 
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://explorer.mainnet.chain.robinhood.com/
# A key that controls TESTNET funds only. Never put mainnet value behind it.
ROBINHOOD_PRIVATE_KEY=
# Optional: override USDG address.
USDG_ADDRESS=
